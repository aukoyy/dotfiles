# restores windows/tabs on relaunch
window-save-state = always

# --- font ---
font-family = JetBrainsMono Nerd Font
font-size = 14

# --- appearance ---
theme = Catppuccin Mocha
# ghostty +list-themes to browse

# --- macos ---
#macos-option-as-alt = left
# makes alt+f / alt+b work in zsh

# Ghostty config
keybind = ctrl+tab=text:\x1b\x0e
keybind = ctrl+shift+tab=text:\x1b\x10

keybind = cmd+t=text:\x1b\x14
keybind = cmd+w=text:\x1b\x17