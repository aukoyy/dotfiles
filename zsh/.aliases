# DNS check for fullvase.no
dns() {
  if [[ -z "$1" ]]; then
    echo "Usage: dns <domain>"
    return 1
  fi
  
  local domain="$1"
  
  for r in NS MX TXT CNAME; do
    echo "\n### $r"
    dig +short $r "$domain"
  done
  echo "\n### autodiscover"
  dig +short CNAME "autodiscover.$domain"
}

# Decoder for JWT tokens
# > jwt-decode <jwt-token>
jwt-decode() {
  jq -R 'split(".") |.[0:2] | map(@base64d) | map(fromjson)' <<< $1
}

jwt() {
  jq -R 'split(".") |.[0:2] | map(@base64d) | map(fromjson)' <<< $1
}

